// wearedogs-api: serves https://api.wearedogs.net (the site itself stays on GitHub Pages).
//
//   npx wrangler d1 migrations apply sql --remote -c workers/api/wrangler.jsonc
//   npx wrangler deploy -c workers/api/wrangler.jsonc
//   npx wrangler dev -c workers/api/wrangler.jsonc    (local D1; secrets come from workers/api/.dev.vars)
//
// HASH_SALT is a secret (npx wrangler secret put HASH_SALT -c workers/api/wrangler.jsonc).
// Changing it orphans every stored hash, so repeat likes would count again.
//
// Free tier, enforced in src/index.js: D1 writes stop at DAILY_LIKE_ATTEMPT_CAP
// (~60k of the 100k rows/day), the count is edge-cached so D1 reads stay far
// under 5M/day, and the rate limiters below cost nothing.
{
  "name": "wearedogs-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  // Only the custom domain answers: no workers.dev or preview URLs that skip the zone's protections
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.wearedogs.net", "custom_domain": true }],
  "vars": { "ALLOWED_ORIGINS": "https://wearedogs.net,https://www.wearedogs.net" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sql",
      "database_id": "104d3edd-ec68-44e6-8b95-98a0a16df6d2",
      "migrations_dir": "migrations"
    }
  ],
  // Per-IP, per-colo limits. Periods can only be 10 or 60 seconds.
  "ratelimits": [
    { "name": "LIKE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
